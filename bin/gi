#!/bin/bash
#
#	This is a DWIM (Do What I Mean, not what I say) shortcut for when
#	you try typing a git command like "git status -sb" and mistakenly type "gi tstatus -sb"...
#	Happens to me all the time
#

if [[ $# -eq 0 || $1 != t?* ]]; then
	echo 'Does not look like git.'
	exit 1
fi

command=${1#t}
shift

echo 'Looks like git.'
exec git "$command" "$@"
